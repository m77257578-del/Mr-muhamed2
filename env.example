# انسخ هذا الملف باسم .env وعبّئ القيم (أو أضفها كمتغيرات بيئة في الاستضافة)
# كلمة مرور المعلم (12 حرفاً على الأقل). لو تركتها فاضية يولّد الخادم كلمة مرور ويطبعها عند أول تشغيل
TEACHER_PASSWORD=
# مفتاح سري لتوقيع جلسات الدخول (اختياري - نص عشوائي طويل). لو تركته فاضي يُستخدم مفتاح مولَّد داخل data/db.json
SESSION_SECRET=
# Vercel/Supabase (للنشر على Vercel أضفها في Environment Variables)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# المنفذ (اختياري - الاستضافات تحدده تلقائياً)
PORT=3000
# مجلد حفظ البيانات والملفات المرفوعة (اختياري - الافتراضي data)
DATA_DIR=

# المساعد الذكي Gemini (اختياري)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# الدفع الإلكتروني Kashier (اختياري)
KASHIER_MID=
KASHIER_API_KEY=
KASHIER_SECRET_KEY=
KASHIER_MODE=test
